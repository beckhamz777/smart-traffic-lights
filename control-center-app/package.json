{
  "name": "smart-traffic-control-center",
  "version": "2.1.0",
  "description": "Standalone MQTT Traffic Control System Desktop App for ESP32 Smart Traffic Lights",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win"
  },
  "keywords": [
    "esp32",
    "traffic-control",
    "mqtt",
    "control-center"
  ],
  "license": "MIT",
  "dependencies": {
    "mqtt": "^5.10.1"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.smarttraffic.mqttcontrolcenter",
    "productName": "TrafficControlCenter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ]
    }
  }
}

